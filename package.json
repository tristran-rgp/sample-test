{
  "name": "zero-day",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && gh-pages -d dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js'",
    "format:check": "prettier --check 'src/**/*.js' 'tests/**/*.js'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "eslint": "^10.9.0",
    "eslint-scope": "^9.1.2",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "vite": "^7.1.2",
    "vitest": "^4.1.11"
  }
}
